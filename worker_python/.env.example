# ==========================================
# Configuração do Worker Python
# ==========================================

# URL do servidor relay na internet (usando wss:// com seu domínio seguro)
# Exemplo em produção: wss://remote.seu-dominio.com
# Exemplo local: ws://localhost:8080
RELAY_URL=wss://remote.seu-dominio.com

# Identificador único deste worker
WORKER_ID=worker-corporativo-01

# Nome amigável exibido no painel da Smart TV / navegador
WORKER_NAME=Estação de Trabalho - Elétrica 01

# Índice da tela (1, 2, ...); deixe vazio para escolher ao iniciar o worker
WORKER_MONITOR=

# Chave Privada do Worker (Padrão DataGate WORKER_SECRET)
# Deve ser IDÊNTICA à configurada no servidor Node
WORKER_SECRET=kna_sec_7f9c2e4a8b1d6f30a9e52c84d710ab9e4321
WORKER_AUTH_KEY=kna_sec_7f9c2e4a8b1d6f30a9e52c84d710ab9e4321
